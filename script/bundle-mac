#!/usr/bin/env bash
# Build Maze.app and pack it for distribution (PLAN §4.16).
#
# The command line client is the same binary: Maze.app/Contents/MacOS/mazemail.
#
# Usage: script/bundle-mac [options]
#   --target <triple>               Rust target (default: the host's apple-darwin triple)
#   --binary <path>                 use a prebuilt binary instead of running cargo
#   --build-number <n>              CFBundleVersion (default: git rev-list --count HEAD)
#   --provisioning-profile <path>   embed a Developer ID provisioning profile (PLAN §4.17)
#   --output-dir <dir>              default: dist
#   --no-package                    only create the bundle, skip .app.tar.zst and .dmg
#   -h, --help
#
# Environment:
#   RELEASE_CHANNEL_FILE   file holding dev|preview|stable
#                          (default: crates/mazemail/RELEASE_CHANNEL; missing means dev)
#   MAZEMAIL_FEATURES      cargo features of the build (default: original-html, the
#                          Servo engine of ADR-020; needs Python >= 3.11 or uv on PATH
#                          for Servo's build scripts)
#   MAZEMAIL_BUILD_VERSION, MAZEMAIL_BUILD_CHANNEL
#                          test-only overrides of version.txt and the channel file, for
#                          the end-to-end update test (cargo xtask update-e2e); the
#                          binary must have been built with the same values
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"
# shellcheck source=script/lib/mac-bundle.bash
source script/lib/mac-bundle.bash

usage() { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'; }

target=""
binary=""
build_number=""
profile=""
out="dist"
package=1

while [ "$#" -gt 0 ]; do
  case $1 in
    --target) target=${2:?missing value for --target}; shift 2 ;;
    --binary) binary=${2:?missing value for --binary}; shift 2 ;;
    --build-number) build_number=${2:?missing value for --build-number}; shift 2 ;;
    --provisioning-profile) profile=${2:?missing value for --provisioning-profile}; shift 2 ;;
    --output-dir) out=${2:?missing value for --output-dir}; shift 2 ;;
    --no-package) package=0; shift ;;
    -h | --help) usage; exit 0 ;;
    *) echo "error: unknown option $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [ "$(uname -s)" != "Darwin" ]; then
  echo "error: script/bundle-mac only runs on macOS" >&2
  exit 1
fi

if [ -z "$target" ]; then
  case $(uname -m) in
    arm64 | aarch64) target=aarch64-apple-darwin ;;
    x86_64) target=x86_64-apple-darwin ;;
    *) echo "error: unsupported host architecture $(uname -m)" >&2; exit 1 ;;
  esac
fi
case $target in
  aarch64-apple-darwin) arch=aarch64 ;;
  x86_64-apple-darwin) arch=x86_64 ;;
  *) echo "error: unsupported target $target" >&2; exit 1 ;;
esac

version=${MAZEMAIL_BUILD_VERSION:-$(tr -d '[:space:]' < version.txt)}
if [ -z "$version" ]; then
  echo "error: version.txt is empty" >&2
  exit 1
fi
build_number=${build_number:-$(git rev-list --count HEAD)}

channel=$(mac_release_channel)
bundle_id=$(mac_bundle_id "$channel")

if [ -z "$binary" ]; then
  cargo build --release --locked --target "$target" --package mazemail \
    --features "${MAZEMAIL_FEATURES-original-html}"
  binary="target/$target/release/mazemail"
fi
if [ ! -x "$binary" ]; then
  echo "error: binary $binary not found or not executable" >&2
  exit 1
fi

bundle_dir="$out/mac-$arch"
app="$bundle_dir/Maze.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"

cp "$binary" "$app/Contents/MacOS/mazemail"
chmod 755 "$app/Contents/MacOS/mazemail"

icon=""
if [ -f assets/icons/Maze.icns ]; then
  cp assets/icons/Maze.icns "$app/Contents/Resources/Maze.icns"
  icon=Maze
fi

if [ -n "$profile" ]; then
  cp "$profile" "$app/Contents/embedded.provisionprofile"
fi

mac_info_plist "$bundle_id" Maze "$version" "$build_number" "$icon" 1 > "$app/Contents/Info.plist"
printf 'APPL????' > "$app/Contents/PkgInfo"

plutil -lint "$app/Contents/Info.plist" >&2

echo "bundle: $app (version $version, build $build_number, channel $channel, id $bundle_id)" >&2

if [ "$package" -eq 1 ]; then
  script/package-mac "$app" "$version" "$arch" "$out"
fi
