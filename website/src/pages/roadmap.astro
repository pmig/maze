---
import Base from "../layouts/Base.astro";
import { SITE, repoFile } from "../data/site";

type State = "done" | "progress" | "next" | "later";

interface Stage {
  name: string;
  state: State;
  summary: string;
  done?: string[];
  todo?: string[];
}

const STATE_LABEL: Record<State, string> = {
  done: "Done",
  progress: "In progress",
  next: "Next",
  later: "Later",
};

// From the project plan's milestones (PLAN §5) and the README's status list.
const STAGES: Stage[] = [
  {
    name: "Foundations",
    state: "done",
    summary: "The workspace, CI, the release process and an updater that works from the very first release.",
    done: [
      "Signed and notarized macOS builds, .dmg and Linux tarball for every release",
      "Background updates with Restart to update, signed manifests and rollback",
      "Release notes and versions from conventional commits (release-please)",
    ],
  },
  {
    name: "Data layer",
    state: "done",
    summary: "One local store for all your mail, encrypted from the first commit.",
    done: [
      "SQLCipher database, encrypted message files and an encrypted Tantivy search index",
      "Threading, a sanitizing MIME parser and the reader model",
      "Measured at 1M messages with encryption on",
    ],
  },
  {
    name: "Sync",
    state: "done",
    summary: "Accounts, live sync and sending.",
    done: [
      "IMAP, Gmail and Microsoft 365 accounts, password or browser sign-in, Test Connection",
      "CONDSTORE/QRESYNC delta sync, IDLE and Gmail labels",
      "SMTP sending, the outbox and the send log, so nothing is sent twice",
    ],
  },
  {
    name: "Reading UI",
    state: "progress",
    summary: "The Thunderbird layout, rendered by GPUI, with Zed's tabs and splits.",
    done: [
      "Folder pane with Favorites and special folders first, message list as cards or a table, reader view",
      "Original HTML view (Servo, no scripts, remote images only when you allow them; macOS)",
      "Tabs and splits for mail views, messages and drafts, restored after a restart",
      "Quick Filter, global search, command palette, Thunderbird shortcuts",
      "Sort by any column, multi-select, Quick Move and right-click menus",
      "Archive, move, delete, tag, flag and mark read, with undo",
      "DKIM, SPF and DMARC results, the sender's mail client, link previews and safe link opening",
      "settings.json in a tab, Zed themes, an adjustable font size",
    ],
    todo: [
      "A settings window, showing the recovery key",
      "Notifications for new mail",
      "Find, keyboard scrolling and printing in the original view",
    ],
  },
  {
    name: "Thunderbird import",
    state: "done",
    summary: "Move over without losing anything, and keep Thunderbird running alongside.",
    done: [
      "Thunderbird profiles: IMAP accounts, identities, signatures, tags, saved searches, address books",
      "mbox and Maildir import into an IMAP folder, and export back to mbox or Maildir",
      "Filters are imported and kept, disabled, until rules arrive",
    ],
  },
  {
    name: "Writing mail",
    state: "progress",
    summary: "The second half of an email client: the basics are in.",
    done: [
      "Compose, reply and forward in tabs, written in Markdown, sent as plain text and HTML",
      "From picks the identity; replies pick the one the message was sent to",
      "A copy in Sent, a footer and an optional \"Sent with Maze\" line",
    ],
    todo: [
      "Drafts in the server's Drafts folder, forwarding attachments",
      "Send later and undo send",
      "Address book autocomplete, spell check, pre-send checks",
      "Signatures that switch with the identity",
      "Filter rules, including your imported Thunderbird filters",
      "Maze as the system's mailto: handler",
    ],
  },
  {
    name: "Agents",
    state: "progress",
    summary: "Agents propose, you review, in the CLI and in Maze's own agent column.",
    done: [
      "The mazemail CLI with scoped tokens, profiles and approvals",
      "Headless mode, and a generated CLI reference for agents",
      "The agent column: Claude Code, Codex, Gemini CLI, Cursor, pi and your own agents over ACP",
      "Sign-in from the column, mode, model and thinking pickers, updates in the background",
      "Reviewing and applying proposals in Maze",
      "An agent sandbox that can't read the store or your home folder (Seatbelt on macOS, bubblewrap on Linux)",
    ],
    todo: [
      "Limiting agents to certain network hosts, and the seccomp filter on Linux",
      "A built-in assistant: summaries, smart replies, inline writing help",
    ],
  },
  {
    name: "Stable release",
    state: "later",
    summary: "Hardening for the first stable channel release.",
    todo: [
      "Opt-in crash reports",
      "Storage key rotation",
      "Linux packaging polish (Flatpak), and the original HTML view on Linux",
    ],
  },
  {
    name: "After that",
    state: "later",
    summary: "Ideas with a plan, not a date.",
    todo: [
      "Related mail and search by meaning, computed locally",
      "WebAssembly extensions with explicit capabilities",
      "JMAP and Microsoft Graph, Windows",
    ],
  },
];
---

<Base title="Roadmap" description="What works in Maze today and what comes next: drafts on the server, send later, rules, notifications, a settings window and search by meaning.">
  <div class="frame">
    <section class="section head">
      <p class="eyebrow">Roadmap</p>
      <h1>Where Maze is going.</h1>
      <p class="lede">
        Maze is built in milestones. Reading, writing and agents are in; what's left on the way
        to a daily driver is filling them out: drafts on the server, send later, rules,
        notifications and a settings window. No dates, just order. The design decisions are on
        <a href={repoFile("docs/adr/README.md")}>GitHub</a>.
      </p>
      <ul class="legend" aria-label="Legend">
        {
          (["done", "progress", "next", "later"] as State[])
            .filter((s) => STAGES.some((stage) => stage.state === s))
            .map((s) => <li class={`state state--${s}`}>{STATE_LABEL[s]}</li>)
        }
      </ul>
    </section>

    <section class="section timeline-wrap" aria-label="Milestones">
      <ol class="timeline">
        {
          STAGES.map((stage) => (
            <li class={`stage stage--${stage.state}`}>
              <div class="marker" aria-hidden="true" />
              <div class="body">
                <div class="stage-head">
                  <h2>{stage.name}</h2>
                  <span class={`state state--${stage.state}`}>{STATE_LABEL[stage.state]}</span>
                </div>
                <p class="summary">{stage.summary}</p>
                {(stage.done || stage.todo) && (
                  <ul class="items">
                    {stage.done?.map((item) => (
                      <li class="item item--done">
                        <span class="visually-hidden">Done: </span>
                        {item}
                      </li>
                    ))}
                    {stage.todo?.map((item) => (
                      <li class="item item--todo">
                        <span class="visually-hidden">Planned: </span>
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="note muted">
        Have an opinion about the order? <a href={SITE.issues}>Open an issue</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .head h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
  }

  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .state::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .state--done::before {
    background: var(--amber);
  }

  .state--progress::before {
    background: linear-gradient(90deg, var(--amber) 50%, transparent 50%);
    border: 1px solid var(--amber);
  }

  .state--next::before {
    background: var(--accent);
  }

  .state--later::before {
    border: 1.5px dashed var(--faint);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 52rem;
  }

  .stage {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    padding-bottom: 2.25rem;
  }

  .stage::before {
    content: "";
    position: absolute;
    left: calc(0.5rem - 0.5px);
    top: 1.1rem;
    bottom: -0.2rem;
    border-left: 1px solid var(--border-strong);
  }

  .stage:last-child::before {
    display: none;
  }

  .marker {
    width: 1rem;
    height: 1rem;
    margin-top: 0.3rem;
    border-radius: 50%;
    background: var(--bg-frame);
    border: 2px solid var(--border-strong);
    position: relative;
  }

  .stage--done .marker {
    background: var(--amber);
    border-color: var(--amber);
  }

  .stage--progress .marker {
    border-color: var(--amber);
    background: linear-gradient(90deg, var(--amber) 50%, var(--bg-frame) 50%);
  }

  .stage--next .marker {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .stage--later .marker {
    border-style: dashed;
  }

  .stage-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .stage h2 {
    font-size: 1.25rem;
  }

  .summary {
    margin-top: 0.35rem;
    color: var(--muted);
  }

  .items {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.9375rem;
  }

  .item {
    position: relative;
    padding-left: 1.5rem;
  }

  .item::before {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .item--done::before {
    content: "✓";
    color: var(--text);
  }

  .item--todo {
    color: var(--muted);
  }

  .item--todo::before {
    content: "○";
    color: var(--faint);
  }

  .note {
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }
</style>
