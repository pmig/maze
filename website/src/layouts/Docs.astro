---
// Docs pages: sidebar on the left, the rendered Markdown in the middle, an on-page
// table of contents on the right. Collapses to one column on small screens.
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import DocsNav from "../components/DocsNav.astro";
import { DOC_ORDER } from "../data/docs";
import { SITE, repoFile } from "../data/site";

interface Props {
  title: string;
  description?: string | undefined;
  /** The doc's id (e.g. "cli"), for the sidebar and prev/next links. */
  id?: string | undefined;
  headings?: MarkdownHeading[] | undefined;
  /** Repository path of the source file, for the "Edit on GitHub" link. */
  source?: string | undefined;
}

const { title, description, id, headings = [], source } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const index = DOC_ORDER.findIndex((d) => d.id === id);
const prev = index > 0 ? DOC_ORDER[index - 1] : undefined;
const next = index >= 0 && index < DOC_ORDER.length - 1 ? DOC_ORDER[index + 1] : undefined;
---

<Base title={title} description={description}>
  <div class="frame docs">
    <div class="sidebar">
      <details class="sidebar-details">
        <summary>Documentation menu</summary>
        <DocsNav id={id} label="Docs pages (compact)" />
      </details>
      <div class="sidebar-static">
        <DocsNav id={id} label="Docs pages" />
      </div>
    </div>

    <article class="content">
      <div class="prose">
        <slot />
      </div>

      <footer class="doc-footer">
        {
          source && (
            <p class="edit">
              <a href={repoFile(source)}>View or edit this page on GitHub</a>
              <span class="muted"> · rendered from <code>{source}</code></span>
            </p>
          )
        }
        {
          (prev || next) && (
            <nav class="pager" aria-label="Previous and next page">
              {prev ? (
                <a class="prev" href={`/docs/${prev.id}/`}>
                  <span>Previous</span>
                  {prev.title}
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a class="next" href={`/docs/${next.id}/`}>
                  <span>Next</span>
                  {next.title}
                </a>
              )}
            </nav>
          )
        }
      </footer>
    </article>

    <div class="toc">
      {
        toc.length > 0 && (
          <nav aria-label="On this page">
            <p class="group-title">On this page</p>
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <p class="help">Questions? <a href={SITE.issues}>Open an issue</a></p>
    </div>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr) 14rem;
    min-height: calc(100vh - var(--header-h));
  }

  .sidebar,
  .toc {
    position: sticky;
    top: var(--header-h);
    align-self: start;
    max-height: calc(100vh - var(--header-h));
    overflow-y: auto;
    padding: 2rem 1.25rem;
    font-size: 0.875rem;
  }



  .sidebar-details {
    display: none;
  }

  .group-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 0.4rem;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .content {
    padding: 2.25rem clamp(1.25rem, 4vw, 3rem) 3rem;
    min-width: 0;
    border-left: 1px solid var(--border);
  }

  @media (min-width: 1181px) {
    .content {
      border-right: 1px solid var(--border);
    }
  }

  .prose {
    max-width: 46rem;
  }

  .toc a {
    display: block;
    padding: 0.2rem 0;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.4;
  }

  .toc a:hover {
    color: var(--text-strong);
  }

  .toc .d3 a {
    padding-left: 0.85rem;
    font-size: 0.8125rem;
  }

  .help {
    color: var(--faint);
  }

  nav + .help {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-size: 0.8125rem;
  }

  .doc-footer {
    max-width: 46rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 1.5rem;
    font-size: 0.875rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .pager a {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-strong);
    font-weight: 500;
  }

  .pager a:hover {
    border-color: var(--accent);
  }

  .pager span {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--faint);
  }

  .pager .next {
    text-align: right;
    grid-column: 2;
  }

  @media (max-width: 1180px) {
    .docs {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
    }
    .content {
      border-left: 0;
    }
    .sidebar {
      position: static;
      max-height: none;
      border-bottom: 1px solid var(--border);
      padding: 0.75rem var(--gutter);
    }
    .sidebar-static {
      display: none;
    }
    .sidebar-details {
      display: block;
    }
    .sidebar-details summary {
      display: block;
      cursor: pointer;
      font-weight: 500;
      color: var(--text-strong);
      padding: 0.25rem 0;
    }
    .sidebar-details[open] summary {
      margin-bottom: 0.75rem;
    }
  }
</style>
