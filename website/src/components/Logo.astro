---
// The Maze mark for the header, footer and 404 page: the envelope from the app icon
// (assets/icons/maze.svg) without its tile, framed by a border in the flap's middle
// gray. `size` is the height; the mark is 1.411 times as wide.
interface Props {
  size?: number | undefined;
}
const { size = 24 } = Astro.props;
const width = Math.round(size * 1.4106);
---

<svg width={width} height={size} viewBox="125.5 238 773 548" aria-hidden="true" focusable="false">
