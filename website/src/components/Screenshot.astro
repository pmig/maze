---
// A screenshot of Maze in a thin window frame, served as AVIF/WebP at several widths.
// With `dark`, the light (`src`) or dark variant follows the site's theme (ThemedImage).
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import ThemedImage from "./ThemedImage.astro";

interface Props {
  src: ImageMetadata;
  /** The same view in Maze's dark theme, shown when the site is dark. */
  dark?: ImageMetadata | undefined;
  alt: string;
  caption?: string | undefined;
  /** The hero image: load it eagerly and with high priority. */
  priority?: boolean | undefined;
  sizes?: string | undefined;
}

const { src, dark, alt, caption, priority = false, sizes = "(max-width: 1240px) 100vw, 1136px" } = Astro.props;
---

<figure class="shot">
  <div class="window">
    {dark ? (
      <ThemedImage light={src} dark={dark} alt={alt} priority={priority} sizes={sizes} />
    ) : (
    <Picture
      src={src}
      alt={alt}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[640, 960, 1280, 1700, 2272]}
      sizes={sizes}
      quality={78}
      loading={priority ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={priority ? "high" : "auto"}
    />
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0;
  }

  .window {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shot-shadow);
  }

  .window :global(img) {
    width: 100%;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--faint);
    text-align: center;
  }
</style>
