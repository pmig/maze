---
// An animated, Cursor-style agent conversation on the home page: a task is typed into
// the prompt, the agent runs a few `mazemail` commands, and its changes come back as a
// proposal that gets accepted. public/agent-demo.js plays it; without JavaScript (and
// before it runs) the first task shows in its final state. The panel is decoration
// (aria-hidden, nothing focusable); the list after it says the same for screen readers.
// Mail and ids are made up. Tasks marked `soon` aren't shipped yet and carry a badge.

interface Row {
  who: string;
  what: string;
  when: string;
}
interface Tool {
  cmd: string;
  result: string;
  out?: string[];
}
interface Task {
  title: string;
  prompt: string;
  agent: string;
  soon?: boolean;
  thought: string;
  tools: Tool[];
  say: string;
  proposal: { id: string; title: string; rows: Row[]; more: string; done: string; diff?: boolean };
  final: string;
  summary: string;
}

const TASKS: Task[] = [
  {
    title: "Old receipts and error reports",
    prompt: "Find and delete all transaction and error-report emails older than 30 days",
    agent: "Claude Code",
    thought: "Thought for 3s",
    tools: [
      {
        cmd: `mazemail search 'older_than:30d (receipt OR invoice OR "payment confirmation")' --ids`,
        result: "182 messages",
      },
      {
        cmd: `mazemail search 'older_than:30d ("error report" OR "build failed" OR from:alerts)' --ids`,
        result: "32 messages",
      },
      { cmd: "mazemail folders", result: "Trash is f_7k" },
      { cmd: "mazemail move --to f_7k m_3c9a m_41de m_52b0 m_5f1c m_6a07 …", result: "proposed" },
    ],
    say: "214 messages match: 182 receipts and payment confirmations, 32 error reports. I proposed moving them to Trash.",
    proposal: {
      id: "p_2c41",
      title: "Move 214 messages to Trash",
      rows: [
        { who: "Northwind Store", what: "Your receipt #48213", when: "Sep 12" },
        { who: "build-bot", what: "Nightly build failed: 3 errors in api", when: "Sep 8" },
        { who: "Example Bank", what: "Payment confirmation", when: "Aug 30" },
      ],
      more: "and 211 more",
      done: "Accepted: 214 moved to Trash",
    },
    final: "Done. All 214 are in Trash.",
    summary:
      "“Find and delete all transaction and error-report emails older than 30 days.” The agent searches with mazemail search and proposes moving 214 messages to Trash; you accept the proposal in Maze.",
  },
  {
    title: "Enrich contacts from signatures",
    prompt: "Enrich all my contacts with the details from my email signatures",
    agent: "Codex",
    soon: true,
    thought: "Thought for 4s",
    tools: [
      { cmd: "mazemail contacts --json", result: "146 contacts" },
      {
        cmd: "mazemail show m_8f3a2c --signature",
        result: "38 signatures",
        out: ["Anna Berger · Head of Operations", "Northwind Traders · +44 20 7946 0142"],
      },
      { cmd: "mazemail contacts propose enrich.json", result: "proposed" },
    ],
    say: "38 contacts have newer details in their signatures. Each change names the mail it came from.",
    proposal: {
      id: "p_5e07",
      title: "Update 38 contacts",
      diff: true,
      rows: [
        { who: "Anna Berger", what: "+ phone +44 20 7946 0142  + title Head of Operations", when: "12 Oct" },
        { who: "Ravi Menon", what: "+ company Fabrikam Ltd  ~ phone +1 202 555 0147", when: "3 Oct" },
        { who: "Lea Novak", what: "+ title Product Designer", when: "28 Sep" },
      ],
      more: "and 35 more",
      done: "Accepted: 38 contacts updated",
    },
    final: "Done. Your contacts are updated on the server.",
    summary:
      "Planned, not available yet: “Enrich all my contacts with the details from my email signatures.” The agent would propose field changes per contact, such as a phone number or a job title, each with the mail it came from, for you to accept.",
  },
  {
    title: "Mail that needs a reply",
    prompt: "Go through my unread inbox and flag everything that still needs a reply from me",
    agent: "Cursor",
    thought: "Thought for 2s",
    tools: [
      {
        cmd: "mazemail search 'in:inbox is:unread' --limit 100",
        result: "23 messages",
        out: ["m_8f3a2c  Anna Berger   Q4 planning: budget by Friday?", "m_7d10e4  Tom Fischer   Contract draft, two questions"],
      },
      { cmd: "mazemail show t_19bd --format md", result: "read 23 threads" },
      { cmd: "mazemail flag t_19bd t_2a07 t_31c4 t_4f82", result: "proposed" },
    ],
    say: "4 of the 23 unread messages ask you something directly. The rest are notifications and newsletters.",
    proposal: {
      id: "p_6b12",
      title: "Flag 4 threads",
      rows: [
        { who: "Anna Berger", what: "Q4 planning: can you confirm the budget by Friday?", when: "Oct 28" },
        { who: "Tom Fischer", what: "Contract draft, two questions", when: "Oct 27" },
        { who: "Lea Novak", what: "Offsite: which dates work for you?", when: "Oct 26" },
      ],
      more: "and 1 more",
      done: "Accepted: 4 threads flagged",
    },
    final: "Done. The 4 threads are flagged in your Inbox.",
    summary:
      "“Go through my unread inbox and flag everything that still needs a reply from me.” The agent reads the unread threads and proposes flagging the 4 that ask you something.",
  },
  {
    title: "Unopened newsletters",
    prompt: "Archive the newsletters I haven't opened in two weeks",
    agent: "Gemini CLI",
    thought: "Thought for 2s",
    tools: [
      { cmd: "mazemail search 'list:news is:unread older_than:14d' --ids", result: "86 messages" },
      { cmd: "mazemail archive m_0b7e m_12fa m_1c33 m_20d9 m_2e41 …", result: "proposed" },
    ],
    say: "86 unread newsletters from 9 lists are older than two weeks. I proposed archiving them.",
    proposal: {
      id: "p_7a90",
      title: "Archive 86 messages",
      rows: [
        { who: "The Weekly Byte", what: "Issue 212: smaller binaries, faster builds", when: "Oct 14" },
        { who: "Contoso Cloud", what: "What's new in October", when: "Oct 9" },
        { who: "Fabrikam Journal", what: "Five reads for the weekend", when: "Oct 3" },
      ],
      more: "and 83 more",
      done: "Accepted: 86 archived",
    },
    final: "Done. 86 newsletters moved to Archive.",
    summary:
      "“Archive the newsletters I haven't opened in two weeks.” The agent finds 86 unread newsletters and proposes archiving them.",
  },
];
---

<div class="ag-wrap">
  <div class="ag" data-agent-demo aria-hidden="true">
    <div class="ag-bar">
      <span class="ag-lights"><i></i><i></i><i></i></span>
      <span class="ag-tab"><span data-ag-title>{TASKS[0]?.title}</span></span>
      <span class="ag-chip ag-chip--sandbox">
        <svg viewBox="0 0 16 16" width="11" height="11"><path d="M8 1.5 2.75 3.5v4c0 3.2 2.2 5.8 5.25 7 3.05-1.2 5.25-3.8 5.25-7v-4Z"></path></svg>
        sandboxed
      </span>
      <span class="ag-chip">triage</span>
    </div>
    <div class="ag-body">
      <ol class="ag-side">
        <li class="ag-side-h">Conversations</li>
        {
          TASKS.map((t, i) => (
            <li class:list={["ag-side-i", { on: i === 0 }]}>
              <span class="ag-side-t">{t.title}</span>
              {t.soon && <span class="ag-soon">Soon</span>}
            </li>
          ))
        }
      </ol>
      <div class="ag-main">
        <div class="ag-stage">
          {
            TASKS.map((t) => (
              <div class="ag-task" data-agent={t.agent} data-title={t.title}>
                <p class="ag-user ag-step">{t.prompt}</p>
                <div class="ag-row ag-think ag-step" data-dur="1100">
                  <span class="ag-pending">Thinking</span>
                  <span class="ag-result">{t.thought}</span>
                </div>
                {t.tools.map((tool) => (
                  <div class="ag-row ag-tool ag-step" data-dur={tool.out ? "1000" : "700"}>
                    <span class="ag-ico">
                      <i class="ag-spin" />
                      <svg class="ag-check" viewBox="0 0 16 16" width="12" height="12"><path d="m3.5 8.5 3 3 6-7" /></svg>
                    </span>
                    <code class="ag-cmd">{tool.cmd}</code>
                    <span class="ag-result">{tool.result}</span>
                    {tool.out && (
                      <div class="ag-outwrap">
                        <pre class="ag-out">{tool.out.join("\n")}</pre>
                      </div>
                    )}
                  </div>
                ))}
                <p class="ag-say ag-step">{t.say}</p>
                <div class:list={["ag-card ag-step", { "ag-card--diff": t.proposal.diff }]}>
                  <div class="ag-card-h">
                    <span>Proposal · {t.proposal.id}</span>
                    {t.soon && <span class="ag-soon">Soon</span>}
                  </div>
                  <p class="ag-card-t">{t.proposal.title}</p>
                  <ul class="ag-rows">
                    {t.proposal.rows.map((r) => (
                      <li>
                        <span class="ag-who">{r.who}</span>
                        <span class="ag-what">{r.what}</span>
                        <span class="ag-when">{t.proposal.diff ? `mail of ${r.when}` : r.when}</span>
                      </li>
                    ))}
                    <li class="ag-more">{t.proposal.more}</li>
                  </ul>
                  <div class="ag-actions">
                    <span class="ag-btn">Reject all</span>
                    <span class="ag-btn ag-btn--primary" data-accept>
                      Accept all <span class="ag-kbd">⌘⇧⏎</span>
                    </span>
                    <span class="ag-accepted">
                      <svg viewBox="0 0 16 16" width="12" height="12"><path d="m3.5 8.5 3 3 6-7" /></svg>
                      {t.proposal.done}
                    </span>
                  </div>
                </div>
                <p class="ag-say ag-step">{t.final}</p>
              </div>
            ))
          }
        </div>
        <div class="ag-input">
          <p class="ag-field"><span data-ag-typed></span><span class="ag-caret"></span><span class="ag-ph">Ask the agent about your mail</span></p>
          <div class="ag-input-f">
            <span class="ag-chip"><span data-ag-agent>{TASKS[0]?.agent}</span> ⌄</span>
            <span class="ag-send">
              <svg class="ag-up" viewBox="0 0 16 16" width="12" height="12"><path d="M8 13V3.5M4 7.5l4-4 4 4"></path></svg>
              <i class="ag-stop"></i>
            </span>
          </div>
        </div>
      </div>
    </div>
    <svg class="ag-cursor" viewBox="0 0 16 22" width="16" height="22"><path d="M1.5 1.5v16l4.2-4 2.8 6.3 2.6-1.1-2.8-6.2h5.9Z"></path></svg>
  </div>
  <div class="ag-foot">
    <p>Made-up mail. The contacts example is planned (<a href="/roadmap/">roadmap</a>); the others work today.</p>
    <button class="ag-pause" type="button" data-ag-pause hidden>Pause</button>
  </div>
  <div class="visually-hidden">
    <p>Examples of what you can ask an agent in Maze:</p>
    <ul>{TASKS.map((t) => <li>{t.summary}</li>)}</ul>
  </div>
</div>

<style is:global>
  .ag-wrap {
    margin-top: 2.25rem;
  }

  .ag {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 35rem;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shot-shadow);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text);
    user-select: none;
  }

  .ag svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  .ag p {
    text-wrap: initial;
  }

  /* Title bar */
  .ag-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    flex: none;
    padding: 0 0.75rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .ag-lights {
    display: inline-flex;
    gap: 0.35rem;
    margin-right: 0.5rem;
  }

  .ag-lights i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .ag-tab {
    display: inline-flex;
    align-items: center;
    height: 100%;
    margin-right: auto;
    padding: 0 0.85rem;
    border-inline: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-strong);
    font-size: 0.75rem;
    white-space: nowrap;
    box-shadow: 0 1px 0 var(--surface);
  }

  .ag-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    height: 1.35rem;
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .ag-body {
    display: flex;
    flex: 1;
    min-height: 0;
  }

  /* Sidebar */
  .ag-side {
    width: 14.5rem;
    flex: none;
    margin: 0;
    padding: 0.75rem 0.5rem;
    list-style: none;
    border-right: 1px solid var(--border);
    background: var(--bg);
  }

  .ag-side-h {
    padding: 0 0.5rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .ag-side-i {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius);
    color: var(--muted);
    transition: background-color 0.2s, color 0.2s;
  }

  .ag-side-i.on {
    background: var(--surface-2);
    color: var(--text-strong);
  }

  .ag-side-t {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ag-soon {
    flex: none;
    margin-left: auto;
    padding: 0 0.4rem;
    border: 1px dashed var(--faint);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.5;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Conversation */
  .ag-main {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .ag-stage {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    scroll-behavior: smooth;
    /* Older steps fade out under the title bar, like a scrolled chat. */
    mask-image: linear-gradient(transparent, #000 3rem);
  }

  .ag-task {
    display: grid;
    gap: 0.6rem;
    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
    padding: 1rem 1.25rem;
    transition: opacity 0.35s ease;
  }

  .ag-task + .ag-task,
  .ag.js .ag-task:not(.cur) {
    display: none;
  }

  .ag.js .ag-task.cur {
    display: grid;
  }

  .ag-task.out {
    opacity: 0;
  }

  .ag-user {
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--surface-2);
    color: var(--text-strong);
  }

  .ag-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .ag-think {
    display: flex;
    gap: 0.4rem;
    color: var(--faint);
  }

  .ag-think::after {
    content: "›";
  }

  .ag-ico {
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
  }

  .ag-spin {
    display: none;
    width: 0.7rem;
    height: 0.7rem;
    border: 1.5px solid var(--border-strong);
    border-top-color: var(--text-strong);
    border-radius: 50%;
    animation: ag-spin 0.7s linear infinite;
  }

  .ag-check {
    color: var(--muted);
  }

  .ag-cmd {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.75rem;
    color: var(--text);
  }

  .ag-result {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--faint);
    white-space: nowrap;
  }

  .ag-think .ag-result {
    font-family: inherit;
    font-size: inherit;
  }

  .ag-pending {
    display: none;
  }

  .ag-outwrap {
    grid-column: 2 / -1;
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.35s ease;
  }

  .ag-out {
    overflow: hidden;
    margin-top: 0.3rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--code-bg);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--muted);
    white-space: pre;
    text-overflow: ellipsis;
  }

  .ag-say {
    color: var(--text);
  }

  /* Proposal card, like the review at the top of Maze's agent column */
  .ag-card {
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--bg-frame);
    overflow: hidden;
  }

  .ag-card-h {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--faint);
  }

  .ag-card-t {
    padding: 0.1rem 0.75rem 0.5rem;
    font-weight: 600;
    color: var(--text-strong);
  }

  .ag-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .ag-rows li {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    padding: 0.3rem 0.75rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
  }

  .ag-rows .ag-more {
    display: block;
    color: var(--faint);
  }

  .ag-who {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-strong);
  }

  .ag-what {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
  }

  .ag-card--diff .ag-what {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text);
    white-space: pre;
  }

  .ag-when {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--faint);
  }

  .ag-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.6rem;
    padding: 0.45rem 0.75rem;
  }

  .ag-btn {
    display: none;
    align-items: center;
    gap: 0.4rem;
    height: 1.6rem;
    padding: 0 0.65rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-strong);
    font-size: 0.75rem;
    font-weight: 500;
    transition: transform 0.12s ease, opacity 0.12s ease;
  }

  .ag-btn--primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-text);
  }

  .ag-btn.press {
    transform: scale(0.95);
    opacity: 0.85;
  }

  .ag-kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    opacity: 0.7;
  }

  .ag-accepted {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-strong);
  }

  .ag-accepted svg {
    color: var(--amber);
    stroke-width: 2.2;
  }

  /* Prompt */
  .ag-input {
    flex: none;
    width: calc(100% - 2.5rem);
    max-width: 43.5rem;
    margin: 0 auto 1rem;
    padding: 0.6rem 0.65rem 0.5rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--surface);
  }

  .ag-field {
    min-height: 2.6em;
    color: var(--text-strong);
  }

  .ag-caret {
    display: inline-block;
    width: 1.5px;
    height: 1.15em;
    margin-right: 1px;
    vertical-align: text-bottom;
    background: var(--text-strong);
    animation: ag-blink 1.1s steps(1) infinite;
  }

  .ag-ph {
    display: none;
    color: var(--faint);
  }

  [data-ag-typed]:empty ~ .ag-ph {
    display: inline;
  }

  .ag-input-f {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.35rem;
  }

  .ag-send {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-text);
  }

  .ag-stop {
    display: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 1.5px;
    background: currentColor;
  }

  .ag.busy .ag-up {
    display: none;
  }

  .ag.busy .ag-stop {
    display: block;
  }

  .ag-cursor {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.25s ease;
  }

  .ag .ag-cursor path {
    fill: #0b0b0d;
    stroke: #fff;
    stroke-width: 1.3;
  }

  .ag-cursor.on {
    opacity: 1;
  }

  .ag-cursor.jump {
    transition: none;
  }

  /* Playing (public/agent-demo.js): steps appear one by one. */
  .ag.live .ag-step:not(.on) {
    display: none;
  }

  .ag.live .ag-step.on {
    animation: ag-in 0.3s ease;
  }

  .ag.live .ag-row:not(.done) .ag-result,
  .ag.live .ag-row:not(.done) .ag-check {
    display: none;
  }

  .ag.live .ag-row:not(.done) .ag-pending,
  .ag.live .ag-row:not(.done) .ag-spin {
    display: inline-block;
  }

