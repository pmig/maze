---
// An image with a light and a dark variant: only the one matching the site's theme is
// shown, following the system appearance or the theme toggle (`data-theme` on <html>),
// like the global styles. Both are optimized pictures (AVIF/WebP at several widths);
// browsers don't fetch a lazy image that isn't displayed.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  /** Load eagerly with high priority (the hero). The hidden variant gets low priority. */
  priority?: boolean | undefined;
  sizes?: string | undefined;
  widths?: number[] | undefined;
}

const {
  light,
  dark,
  alt,
  priority = false,
  sizes = "(max-width: 1240px) 100vw, 1136px",
  widths = [640, 960, 1280, 1700, 2272],
} = Astro.props;

const common = {
  alt,
  formats: ["avif", "webp"] as ("avif" | "webp")[],
  fallbackFormat: "webp" as const,
  widths,
  sizes,
  quality: 78,
  decoding: "async" as const,
  loading: priority ? ("eager" as const) : ("lazy" as const),
};
---

<Picture {...common} src={light} class="themed themed-light" fetchpriority={priority ? "high" : "auto"} />
<Picture {...common} src={dark} class="themed themed-dark" fetchpriority={priority ? "low" : "auto"} />

<style is:global>
  .themed-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .themed-light {
      display: none;
    }
    :root:not([data-theme="light"]) .themed-dark {
      display: block;
    }
  }

  :root[data-theme="dark"] .themed-light {
    display: none;
  }
  :root[data-theme="dark"] .themed-dark {
    display: block;
  }
</style>
