                        <span class="mw-ob"><Fragment set:html={ic("fwd")} />Fwd</span>
                        <span class="mw-ob"><Fragment set:html={ic("archive")} />Archive</span>
                        <span class="mw-ob"><Fragment set:html={ic("octagon")} />Junk</span>
