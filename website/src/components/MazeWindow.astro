    --m-row-on: #f0f0f0;
    --m-folder-on: #e4e4e5;
    --m-ok: #669f59;
    --m-warn: #a48819;
    --m-bad: #d36151;
    --m-hit: color-mix(in srgb, var(--m-acc) 13%, var(--m-bg));

    position: absolute;
    left: 0;
