                  data-counts={t.effect.counts ? JSON.stringify(t.effect.counts) : undefined}
                >
                  <div class="mw-propwrap">
                    <div class="mw-prop mw-step">
                      <div class="mw-ph">
                        <b>Proposed changes · {t.proposal.total}</b>
                        <span class="mw-pb mw-pb--primary" data-accept>
                          Accept all <span class="mw-pk">⌘⇧⏎</span>
                        </span>
                        <span class="mw-pb">Reject all</span>
                      </div>
                      <div class="mw-pg">
                        <div class="mw-pgt">
                          <b>{t.proposal.title}</b>
                          <span>{t.agent}</span>
                          {t.soon && <span class="mw-soon">Soon</span>}
                        </div>
                        {t.proposal.items.map((it, i) => (
                          <div class:list={["mw-pi", { cur: i === 0, "mw-pi--diff": t.proposal.diff }]}>
                            <span class="mw-pit">
                              <span class="mw-pis">{it.summary}</span>
                              <span class="mw-pir">{it.reason}</span>
                            </span>
                            <span class="mw-pia">
                              <Fragment set:html={ic("check")} />
                              <Fragment set:html={ic("x")} />
                            </span>
                            <span class="mw-pid">applied</span>
                          </div>
                        ))}
                        <div class="mw-pmore">{t.proposal.more}</div>
                      </div>
                    </div>
                  </div>
                  <div class="mw-conv">
                    <div class="mw-user mw-step">{t.prompt}</div>
                    <div class="mw-think mw-step" data-dur="1100">
                      <Fragment set:html={ic("sparkles")} />
                      Thinking
                      <Fragment set:html={ic("right")} />
                    </div>
                    {t.tools.map((tool) => (
                      <div class="mw-term mw-step" data-dur={tool.out.length > 1 ? "1000" : "750"} data-hit={tool.hit} data-sig={tool.sig ? "" : undefined}>
                        <div class="mw-th">
                          <Fragment set:html={ic("term")} />
                          <code>{tool.cmd}</code>
                          <span class="mw-auto">auto</span>
                          <i class="mw-spin" />
                          <span class="mw-done">done</span>
                          <Fragment set:html={ic("down")} />
                        </div>
                        <pre class="mw-to2">{tool.out.join("\n")}</pre>
                      </div>
                    ))}
                    <div class="mw-say mw-step">{t.say}</div>
                    <div class="mw-say mw-final mw-step">{t.final}</div>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="mw-af">
            <div class="mw-ctx">
              <span data-mw-ctx>@thread {ROWS[0]!.subject}</span>
            </div>
            <div class="mw-field">
              <span data-mw-typed></span><span class="mw-caret"></span><span class="mw-place">Ask the agent…  ⏎ send, ⇧⏎ new line</span>
            </div>
            <div class="mw-bar">
              <span class="mw-modeb"><span data-mw-mode>{FIRST.mode}</span><Fragment set:html={ic("down")} /></span>
              <span class="mw-grow"></span>
              <span class="mw-send">
                <Fragment set:html={ic("up", "mw-up")} />
                <i class="mw-stop"></i>
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="mw-status">
