                          DKIM <em>pass</em>
                        </span>
                        <span class="mw-chip">
                          SPF <em>pass</em>
                        </span>
                        <span class="mw-chip">
                          DMARC <em>pass</em>
                        </span>
                        <span class="mw-okt">Verified sender</span>
                      </div>
