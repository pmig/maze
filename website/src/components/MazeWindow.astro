    color: var(--m-fg-2);
  }

  .mw-from,
  .mw-subj {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mw-row.u .mw-from {
    font-weight: 600;
  }

  .mw-subj {
    color: var(--m-fg-2);
  }

  .mw-row.u .mw-subj {
    color: var(--m-fg);
  }

  .mw-date {
    flex: none;
    font-size: 11px;
    color: var(--m-fg-2);
  }

  .mw-row.u .mw-date {
    color: var(--m-acc);
  }

  .mw-cnt {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    padding: 0 4px 0 1px;
    border-radius: 3px;
    background: var(--m-panel);
    color: var(--m-fg-2);
    font-size: 10.5px;
    line-height: 16px;
  }

  .mw-cnt .mw-i {
    width: 11px;
    height: 11px;
  }

  .mw-clip {
    width: 12px;
    height: 12px;
    color: var(--m-fg-2);
  }

  .mw-star {
    display: none;
    width: 13px;
    height: 13px;
    color: var(--m-warn);
    fill: currentColor;
  }

  .mw-row.flag .mw-star {
    display: block;
    animation: mw-pop 0.45s ease;
  }

  /* Message view */
  .mw-view {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .mw-msg {
    display: none;
    flex-direction: column;
    height: 100%;
  }

  .mw-msg.cur {
    display: flex;
    animation: mw-fade 0.25s ease;
  }

  .mw-mh {
    display: grid;
    gap: 7px;
    padding: 11px 16px 8px;
    border-bottom: 1px solid var(--m-line);
  }

  .mw-ms {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mw-mfrom {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .mw-av {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 50%;
    background: color-mix(in srgb, var(--m-acc) 20%, transparent);
    color: var(--m-acc);
    font-size: 10.5px;
    font-weight: 600;
  }

  .mw-who {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .mw-who b,
  .mw-addr {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mw-addr {
    font-size: 11px;
    color: var(--m-fg-2);
  }

  .mw-enrich {
    display: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11px;
    color: var(--m-fg);
  }

  .mw-msg.enriched .mw-enrich {
    display: block;
    animation: mw-fade 0.5s ease;
  }

  .mw-mdate {
    flex: none;
    align-self: flex-start;
    padding-top: 2px;
    font-size: 11px;
    color: var(--m-fg-2);
  }

  .mw-to {
    font-size: 12px;
  }

  .mw-to span {
    display: inline-block;
    width: 40px;
    font-size: 11px;
    color: var(--m-fg-2);
  }

  .mw-ver {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    white-space: nowrap;
  }

  .mw-ver .mw-i {
    width: 12px;
    height: 12px;
  }

  .mw-ok,
  .mw-okt {
    color: var(--m-ok);
  }

  .mw-chip {
    padding: 0 4px;
    border: 1px solid var(--m-line);
    border-radius: 3px;
    color: var(--m-fg-2);
  }

  .mw-chip em {
    font-style: normal;
    color: var(--m-ok);
  }

  .mw-acts {
    display: flex;
    align-items: center;
    gap: 3px;
    overflow: hidden;
  }

  .mw-ob {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    flex: none;
    height: 21px;
    padding: 0 4px;
    border: 1px solid var(--m-line);
    border-radius: 4px;
    font-size: 11px;
    white-space: nowrap;
  }

  .mw-ob .mw-i {
    width: 12px;
    height: 12px;
  }

  .mw-mode {
    display: inline-flex;
    gap: 1px;
    margin-left: auto;
    font-size: 10.5px;
  }

  .mw-mode span {
    padding: 2px 4px;
    border-radius: 4px;
  }

  .mw-mode .on {
    background: var(--m-hover);
  }

  .mw-remote {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 16px;
    border-bottom: 1px solid var(--m-line);
    background: var(--m-panel);
    font-size: 11px;
  }

  .mw-remote > span:first-of-type {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mw-remote .mw-i {
    width: 12px;
    height: 12px;
  }

  .mw-body {
    display: grid;
    align-content: start;
    gap: 11px;
    padding: 14px 16px;
    font-size: 13px;
    line-height: 1.5;
    white-space: pre-line;
  }

  .mw-sig {
    margin-top: 2px;
    padding: 4px 6px;
    margin-left: -6px;
    border-radius: 4px;
    color: var(--m-fg-2);
    font-size: 12px;
    transition: background-color 0.4s ease;
  }

  .mw-msg.sig .mw-sig {
    background: var(--m-hit);
    color: var(--m-fg);
  }

  .mw-news {
    gap: 10px;
    margin: 12px 16px;
    padding: 14px;
    border: 1px solid var(--m-line-2);
    background: #ffffff;
    color: #1f2328;
  }

  .mw-nl-top {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #6b4fd8;
  }

  .mw-nl-h {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.25;
  }

  .mw-nl-img {
    display: grid;
    place-items: center;
    height: 92px;
    border: 1px dashed #c8c8cc;
    border-radius: 3px;
    color: #9a9aa0;
  }

  .mw-nl-img--s {
    height: 48px;
  }

  .mw-nl-img .mw-i {
    width: 20px;
    height: 20px;
  }

  /* ---------- Agent column ---------- */

  .mw-agent {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--m-panel);
    border-left: 1px solid var(--m-line);
  }

  .mw-ah {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 32px;
    flex: none;
    padding: 0 4px 0 8px;
    border-bottom: 1px solid var(--m-line);
    background: var(--m-panel);
  }

  .mw-ahi {
    color: var(--m-fg-2);
  }

  .mw-at {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11.5px;
    font-weight: 600;
  }

  .mw-at.ph {
    font-weight: 400;
    color: var(--m-fg-2);
  }

  .mw-ah .mw-btn {
    width: 20px;
    height: 20px;
  }

  .mw-ah .mw-btn .mw-i {
    width: 13px;
    height: 13px;
  }

  .mw-soon {
    flex: none;
    padding: 0 5px;
    border: 1px dashed var(--m-fg-3);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--m-fg-2);
  }

  .mw-soon--head {
    display: none;
  }

  .mw.soon .mw-soon--head {
    display: inline;
  }

  .mw-abody {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  .mw-task {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: opacity 0.35s ease;
  }

  .mw-task + .mw-task,
  .mw.js .mw-task:not(.cur) {
    display: none;
  }

  .mw.js .mw-task.cur {
    display: flex;
  }

  .mw-task.out {
    opacity: 0;
  }

  /* Proposals sit at the top of the column, as in Maze. */
  .mw-propwrap {
    display: grid;
    grid-template-rows: 1fr;
    flex: none;
    transition: grid-template-rows 0.45s ease;
  }

  .mw-prop {
    display: grid;
    gap: 8px;
    min-height: 0;
    overflow: hidden;
    margin: 8px;
    padding: 8px;
    border: 1px solid var(--m-acc);
    border-radius: 8px;
    background: var(--m-bg);
    font-size: 11px;
    transition:
      opacity 0.3s ease,
      margin 0.45s ease,
      padding 0.45s ease,
      border-width 0.45s;
  }

  .mw-ph {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .mw-ph b {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mw-pb {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 20px;
    padding: 0 7px;
    border-radius: 4px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      transform 0.12s ease,
      filter 0.12s ease;
  }

  .mw-pb--primary {
    background: var(--m-acc);
    color: var(--m-acc-fg);
  }

  .mw-pb.press {
    transform: scale(0.94);
    filter: brightness(0.9);
  }

  .mw-pk {
    opacity: 0.75;
  }

  .mw-pg {
    display: grid;
    gap: 2px;
  }

  .mw-pgt {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 1px;
  }

  .mw-pgt > span:not(.mw-soon) {
    color: var(--m-fg-2);
  }

  .mw-pi {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 2px 4px;
    border-radius: 3px;
  }

  .mw-pi.cur {
    background: var(--m-panel);
  }

  .mw-pit {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .mw-pis,
  .mw-pir {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mw-pi--diff .mw-pis {
    font-family: var(--font-mono);
    font-size: 10.5px;
  }

  .mw-pir {
    color: var(--m-fg-2);
  }

  .mw-pia {
    display: inline-flex;
    gap: 6px;
    padding-right: 2px;
    color: var(--m-fg-2);
  }

  .mw-pia .mw-i {
    width: 13px;
    height: 13px;
  }

  .mw-pid {
    display: none;
    color: var(--m-ok);
  }

  .mw-prop.ok .mw-pia {
    display: none;
  }

  .mw-prop.ok .mw-pid {
    display: inline;
  }

  .mw-pmore {
    padding: 0 4px;
    color: var(--m-fg-2);
  }

  .mw-propwrap.gone {
    grid-template-rows: 0fr;
  }

  .mw-propwrap.gone .mw-prop {
    opacity: 0;
    margin-block: 0;
    padding-block: 0;
    border-width: 0;
  }

  /* Conversation: newest at the bottom, older entries fade under the header. */
  .mw-conv {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    padding-bottom: 10px;
    mask-image: linear-gradient(transparent, #000 2.5rem);
  }

  .mw-conv > * {
    flex: none;
  }

  .mw-user {
    margin: 0 8px;
    padding: 8px;
    border: 1px solid var(--m-line);
    border-radius: 6px;
    background: var(--m-bg);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  }

  .mw-think {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 16px;
    font-size: 11px;
    color: var(--m-fg-2);
  }

  .mw-think .mw-i {
    width: 12px;
    height: 12px;
  }

  .mw-term {
    margin: 0 8px;
    overflow: hidden;
    border: 1px solid var(--m-line);
    border-radius: 6px;
    background: var(--m-bg);
  }

  .mw-th {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 8px;
    background: var(--m-panel);
    font-size: 11px;
    color: var(--m-fg-2);
  }

  .mw-th .mw-i {
    width: 12px;
    height: 12px;
  }

  .mw-th code {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--m-fg);
  }

  .mw-done {
    color: var(--m-ok);
  }

  .mw-spin {
    display: none;
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--m-line);
    border-top-color: var(--m-fg-2);
    border-radius: 50%;
    animation: mw-spin 0.7s linear infinite;
  }

  .mw .mw-to2 {
    margin: 0;
    padding: 5px 8px;
    border-top: 1px solid var(--m-line);
    color: var(--m-fg-2);
    line-height: 1.5;
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mw-say {
    padding: 0 16px;
  }

  /* Footer: context chip, prompt and the mode/send bar */
  .mw-af {
    display: grid;
    gap: 6px;
    flex: none;
    padding: 6px 8px 8px;
    border-top: 1px solid var(--m-line);
    background: var(--m-bg);
  }

  .mw-ctx {
    display: flex;
    min-width: 0;
  }

  .mw-ctx span {
    min-width: 0;
    padding: 0 4px;
    border-radius: 3px;
    background: var(--m-panel);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mw-field {
    min-height: 36px;
    padding: 0 2px;
  }

  .mw-caret {
    display: inline-block;
    width: 1.5px;
    height: 1.15em;
    margin-right: 1px;
    vertical-align: text-bottom;
    background: var(--m-acc);
    animation: mw-blink 1.1s steps(1) infinite;
  }

  .mw-place {
    display: none;
    color: var(--m-fg-3);
  }

  [data-mw-typed]:empty ~ .mw-place {
    display: inline;
  }

  .mw-bar {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .mw-modeb {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    height: 22px;
    padding: 0 6px;
    border-radius: 4px;
    font-size: 11px;
    color: var(--m-fg-2);
  }

  .mw-modeb .mw-i {
    width: 11px;
    height: 11px;
  }

  .mw-send {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: var(--m-acc);
    color: var(--m-acc-fg);
  }

  .mw-stop {
    display: none;
    width: 8px;
    height: 8px;
    border-radius: 1.5px;
    background: currentColor;
  }

  .mw.busy .mw-send {
    background: var(--m-bad);
    color: #fff;
  }

  .mw.busy .mw-up {
    display: none;
  }

  .mw.busy .mw-stop {
    display: block;
  }

  /* ---------- Status bar ---------- */

  .mw-status {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 24px;
    flex: none;
    padding: 0 10px;
    background: var(--m-chrome);
    border-top: 1px solid var(--m-line);
    font-size: 11px;
    color: var(--m-fg-2);
  }

  .mw-status > span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  .mw-status .mw-i {
    width: 12px;
    height: 12px;
  }

  .mw-status b {
    font-weight: 500;
    color: var(--m-fg);
  }

  .mw-online {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--m-ok);
  }

  /* ---------- Pointer ---------- */

  .mw-cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    opacity: 0;
    transition:
      transform 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.25s ease;
  }

  .mw-cursor path {
    fill: #0b0b0d;
    stroke: #fff;
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .mw-cursor.on {
    opacity: 1;
  }

  .mw-cursor.jump {
    transition: none;
  }

  /* ---------- Playing (public/maze-window.js) ---------- */

  /* Static (no JavaScript, reduced motion): the task at its proposal. */
  .mw:not(.live) .mw-final,
  .mw:not(.live) .mw-spin,
  .mw:not(.live) .mw-caret {
    display: none;
  }

  .mw.live .mw-step:not(.on) {
    display: none;
  }

  .mw.live .mw-conv .mw-step.on {
    animation: mw-in 0.3s ease;
  }

  .mw.live .mw-prop.on {
    animation: mw-in 0.3s ease;
  }

  .mw.live .mw-term:not(.done) .mw-done,
  .mw.live .mw-term:not(.done) .mw-to2,
  .mw.live .mw-term:not(.done) .mw-th > .mw-i:last-child {
    display: none;
  }

  .mw.live .mw-term:not(.done) .mw-spin {
    display: inline-block;
  }

  .mw.live .mw-think:not(.done) {
    animation: mw-pulse 1.2s ease-in-out infinite;
  }

  .mw.busy .mw-caret {
    animation: none;
    opacity: 0;
  }

  /* Between loops the mailbox fades out, resets and fades back in. */
  .mw-panebody,
  .mw-folders {
    transition: opacity 0.35s ease;
  }

  .mw.resetting .mw-panebody,
  .mw.resetting .mw-folders {
    opacity: 0;
  }

  .mw.resetting .mw-row,
  .mw.resetting .mw-rows {
    transition: none;
  }

  .mw.paused .mw-spin,
  .mw.paused .mw-caret,
  .mw.paused .mw-think {
    animation-play-state: paused;
  }

  @keyframes mw-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @keyframes mw-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes mw-pop {
    0% {
      transform: scale(0.2);
      opacity: 0;
    }
    70% {
      transform: scale(1.25);
    }
  }

  @keyframes mw-bump {
    40% {
      transform: scale(1.18);
    }
  }

  @keyframes mw-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes mw-blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes mw-pulse {
    50% {
      opacity: 0.45;
    }
  }

  /* ---------- Smaller layouts ---------- */

  /* Tablets: no message view (spaces, folders, list, agent). */
  @container (max-width: 959.98px) {
    .mw-main {
      grid-template-columns: 36px 164px 264px 336px;
    }
    .mw-panebody {
      grid-template-columns: 264px;
    }
    .mw-list {
      border-right: 0;
    }
    .mw-view {
      display: none;
    }
    .mw-tab {
      max-width: 100%;
    }
  }

  /* Phones: the list above the agent column. */
  @container (max-width: 559.98px) {
    .mw-lights {
      display: none;
    }
    .mw-search {
      width: 230px;
    }
    .mw-main {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 322px minmax(0, 1fr);
    }
    .mw-spaces,
    .mw-folders,
    .mw-tabs {
      display: none;
    }
    .mw-panebody {
      grid-template-columns: minmax(0, 1fr);
    }
    .mw-agent {
      border-left: 0;
      border-top: 1px solid var(--m-line);
    }
    .mw-status > span:nth-child(2),
    .mw-status > span:nth-child(6) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mw *,
    .mw {
      animation: none !important;
      transition: none !important;
    }
  }

  /* ---------- Under the window ---------- */

  .mw-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
    font-size: 0.8125rem;
    color: var(--faint);
  }

  .mw-foot p {
    max-width: 80ch;
  }

  .mw-foot a {
    color: inherit;
  }

  .mw-pause {
    flex: none;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .mw-pause:hover {
    color: var(--text-strong);
    border-color: var(--border-strong);
  }

  .mw-pause[hidden] {
    display: none;
  }

  @media (max-width: 560px) {
