---
// Maze's main window, rebuilt in HTML and CSS for the home page: title bar, spaces bar,
// folder pane, message list, message and the agent column on the right, in Maze's
// default One Light / One Dark colors, laid out like crates/mail_ui and crates/agent_ui.
// public/maze-window.js plays four agent tasks in it: the prompt is typed into the agent
// column, the agent runs `mazemail` commands, its changes come back as a proposal at the
// top of the column, a pointer accepts it and the mailbox reacts (rows leave, stars
// appear, counts change).
//
// It renders at a fixed design size and is scaled to the width of its container with
// CSS alone (container query units, `tan(atan2())` for the ratio), so its height is
// known before anything loads. Narrower containers get smaller layouts: without the
// message view, and on phones the message list above the agent column.
//
// Without JavaScript (and before it runs) the first task shows at its proposal. The
// window is decoration (aria-hidden, nothing focusable); the list after it says the same
// for screen readers. All mail and ids are made up. Tasks marked `soon` aren't shipped.

interface Row {
  key: string;
  from: string;
  subject: string;
  date: string;
  unread?: boolean;
  count?: number;
  clip?: boolean;
  outgoing?: boolean;
}

interface Msg {
  key: string;
  subject: string;
  from: string;
  email: string;
  date: string;
  body: string[];
  sig?: string[];
  /** An HTML newsletter: Original mode with the remote content banner. */
  html?: boolean;
}

interface Tool {
  cmd: string;
  out: string[];
  /** Rows that light up in the list when the command is done. */
  hit?: string;
  /** Highlight the signature in the message view. */
  sig?: boolean;
}

interface Item {
  summary: string;
  reason: string;
}

interface Task {
  title: string;
  prompt: string;
  agent: string;
  mode: string;
  soon?: boolean;
  /** The row the pointer selects before the prompt. */
  select?: string;
  tools: Tool[];
  say: string;
  proposal: { title: string; total: number; items: Item[]; more: string; diff?: boolean };
  /** What accepting does to the mailbox. */
  effect: {
    gone?: string;
    flag?: string;
    counts?: Record<string, string>;
    /** The row selected once the selected one has left. */
    after?: string;
    enrich?: string;
  };
  final: string;
  summary: string;
}

