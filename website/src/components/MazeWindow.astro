                          <span class="mw-mode">
                            <span>Reader</span>
                            <span class="on">Original</span>
                          </span>
                        )}
                      </div>
                    </div>
                    {m.html && (
                      <div class="mw-remote">
                        <Fragment set:html={ic("shield")} />
                        <span>Remote images are blocked to protect your privacy (6 images blocked, 2 trackers removed).</span>
                        <span class="mw-ob">Load images</span>
                      </div>
                    )}
                    {m.html ? (
                      <div class="mw-body mw-news">
                        <div class="mw-nl-top">THE WEEKLY BYTE · Issue 212</div>
                        <div class="mw-nl-img">
                          <Fragment set:html={ic("image")} />
                        </div>
                        <div class="mw-nl-h">Smaller binaries, faster builds</div>
                        {m.body.map((p) => <p>{p}</p>)}
                        <div class="mw-nl-img mw-nl-img--s">
                          <Fragment set:html={ic("image")} />
                        </div>
                      </div>
                    ) : (
                      <div class="mw-body">
                        {m.body.map((p) => <p>{p}</p>)}
                        {m.sig && <p class="mw-sig">{m.sig.join("\n")}</p>}
                      </div>
                    )}
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="mw-agent">
          <div class="mw-ah">
            <Fragment set:html={ic("bot", "mw-ahi")} />
