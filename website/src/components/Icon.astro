---
// A handful of 16 px line icons, drawn for this site (stroke icons, currentColor).
interface Props {
  name: "download" | "github" | "arrow-right" | "sun" | "moon" | "terminal" | "menu" | "external";
  size?: number | undefined;
  class?: string | undefined;
}
const { name, size = 16, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "download" && <path d="M8 2.5v7.5M4.75 7 8 10.25 11.25 7M3 13.25h10" />}
  {
    name === "github" && (
      <path
        fill="currentColor"
        stroke="none"
        d="M8 .5a7.5 7.5 0 0 0-2.37 14.62c.37.07.5-.16.5-.36v-1.27c-2.08.45-2.52-1-2.52-1-.34-.87-.83-1.1-.83-1.1-.68-.46.05-.45.05-.45.75.05 1.15.77 1.15.77.67 1.15 1.75.82 2.18.62.07-.48.26-.82.48-1-1.66-.19-3.41-.83-3.41-3.7 0-.82.29-1.49.77-2.01-.08-.19-.33-.95.07-1.98 0 0 .63-.2 2.06.77a7.1 7.1 0 0 1 3.75 0c1.43-.97 2.06-.77 2.06-.77.41 1.03.15 1.79.07 1.98.48.52.77 1.19.77 2.01 0 2.88-1.75 3.51-3.42 3.7.27.23.51.69.51 1.39v2.06c0 .2.13.44.51.36A7.5 7.5 0 0 0 8 .5Z"
      />
    )
  }
  {name === "arrow-right" && <path d="M3 8h10M9 4l4 4-4 4" />}
  {
    name === "sun" && (
      <>
        <circle cx="8" cy="8" r="2.75" />
        <path d="M8 1.25v1.5M8 13.25v1.5M1.25 8h1.5M13.25 8h1.5M3.2 3.2l1.07 1.07M11.73 11.73l1.07 1.07M3.2 12.8l1.07-1.07M11.73 4.27l1.07-1.07" />
      </>
    )
  }
  {name === "moon" && <path d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z" />}
  {
    name === "terminal" && (
      <>
        <rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.5" />
        <path d="m4.5 6.25 2 1.75-2 1.75M8.5 10h3" />
      </>
    )
  }
  {name === "menu" && <path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11" />}
  {name === "external" && <path d="M6.5 3.5h-3v9h9v-3M9.5 2.5h4v4M13.25 2.75 7.5 8.5" />}
</svg>
