---
source: crates/import/tests/import/thunderbird.rs
expression: "redact(serde_json::to_value(&report).unwrap(), &profile_dir)"
---
accounts:
  - auth: password_prompt
    host: imap.example.com
    identities: 2
    key: account1
    kind: imap
    name: Work
    port: 993
    username: anna@example.com
  - auth: sign_in_again
    host: imap.gmail.com
    identities: 1
    key: account2
    kind: gmail
    name: anna.example@gmail.com
    port: 993
    username: anna.example@gmail.com
  - auth: none
    host: Local Folders
    identities: 0
    key: account3
    kind: unsupported
    name: Local Folders
    port: ~
    username: nobody
  - auth: none
    host: news.example.org
    identities: 1
    key: account4
    kind: unsupported
    name: news.example.org
    port: 119
    username: ~
  - auth: none
    host: pop.example.net
    identities: 1
    key: account5
    kind: unsupported
    name: anna@example.net
    port: 995
    username: anna@example.net
address_books:
  - contacts: 4
    lists: 1
    name: Personal Address Book
filters: 2
filters_with_unsupported_actions: 1
identities: 3
layout:
  folder_pane_compact: false
  folder_pane_modes:
    - all
    - favorite
    - unified
  folder_pane_width: 286
  message_pane_height: ~
  message_pane_width: 640
  pane_layout: 2
  thread_pane_list_view: 1
offline_store_bytes: 5320
profile: "[profile]"
saved_searches: 2
signatures: 2
smtp_servers: 3
tags: 6
unsupported:
  - item: Local Folders
    reason: "skipped: Maze keeps all mail on your servers — move it into an IMAP folder in Thunderbird, or import its mbox files with `mazemail import <file> --account …`"
  - item: News (NNTP) account news.example.org
    reason: "skipped: Maze supports IMAP accounts only"
  - item: POP3 account anna@example.net
    reason: "skipped: Maze supports IMAP only — enable IMAP at your provider and add it"
  - item: 1 message filters
    reason: "skipped: they belong to accounts Maze doesn't import"
  - item: 2 message filters
    reason: "imported disabled; review and enable them once Maze's rules engine is available"
  - item: 1 mailing lists in Personal Address Book
    reason: Maze has no contact lists yet; their members are imported as contacts
  - item: calendars and tasks
    reason: out of scope for Maze
untranslated_search_terms: 1
