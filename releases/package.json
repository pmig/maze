{
  "name": "mazemail-releases",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Worker that serves Maze's signed update manifests on releases.mazemail.dev",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test",
    "check": "node --test && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  }
}
