// Maze default settings.
//
// Don't edit this file: it is compiled into Maze. Put your changes into
// ~/.config/mazemail/settings.json (Maze Dev: ~/.config/mazemail-dev/settings.json).
// Your file only needs the keys you want to change; it is merged over these defaults.
// Comments and trailing commas are allowed. Accounts, identities and SMTP servers live
// in the encrypted database, not here, so this file never holds addresses.
{
  // Colors. "mode" is "system" (follow macOS), "light" or "dark"; "light" and "dark"
  // name the theme used in each mode. Built in: "One Light" and "One Dark". More themes:
  // put Zed theme files (*.json) into the "themes" folder next to this file.
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },

  // Window layout: "four_column" (folders | list | message | agent),
  // "vertical" (four_column without the agent column), "classic" or "wide"
  // (Thunderbird's layouts).
  "layout": "four_column",
  // Below this window width (in px) the message moves under the list (Classic).
  "narrow_layout_below_px": 1000,

  // The agent column on the right.
  "agent_panel": {
    "visible": true,
    // Width in px.
    "width": 380,
    // Show the agent for the selected message or thread.
    "follow_selection": true,
    // Below this window width (in px) the column collapses to a thin strip.
    "collapse_below_px": 1400
  },

  // The message list.
  "thread_list": {
    // "cards" (two-line rows) or "table" (columns).
    "view": "cards",
    // The order until you sort the list yourself (a click on a column header, the sort
    // button or "Sort By" in the command palette; Maze remembers that order). Any
    // column, "_asc" or "_desc": "date", "received", "from" (the sender),
    // "correspondents", "recipients", "subject" (ignoring "Re:", "Fwd:", … and case),
    // "star", "unread", "attachment", "tags", "account" or "size". "_desc" is newest,
    // largest, Z or starred/unread/with attachments first. Threads sort by what their
    // row shows: their newest message's date, sender and size, their subject, whether
    // any message is starred or unread.
    "sort": "date_desc",
    // Group messages into conversations.
    "threaded": true
  },

  // The folder pane. Combine any of "all", "unified", "favorite", "unread", "tags"
  // and "recent".
  "folder_pane": {
    "modes": ["favorite", "unified"],
    // Folders shown under Favorites, by account label and folder path, e.g.
    // { "account": "work", "folder": "Customers/Acme" }. "Add to Favorites" and
    // "Remove from Favorites" (right-click a folder) edit this list.
    "favorites": []
  },

  // Quick Filter: combine several active filters with "or" or "and".
  "quick_filter": {
    "boolean_mode": "or"
  },

  // The message view.
  "reader": {
    // How HTML mail is shown in the message pane: "reader" (sanitized reader mode,
    // theme colors), "original" (laid out as the sender designed it, by the built-in
    // engine; no scripts, nothing loaded from the network) or "plain_text".
    // Plain-text mail always uses the reader. Switch per message with the
    // Reader/Original buttons or cmd-alt-o.
    "default_mode": "reader",
    // The same for a message opened in a tab of its own (double-click, enter, cmd-o).
    "tab_mode": "original",
    // Remote content (images, fonts, tracking pixels): "ask" (blocked, with a banner
    // to allow it), "never" or "always". Can be overridden per account.
    "remote_content": "ask"
  },

  // Writing mail.
  "compose": {
    // Open the composer in a "tab" (Zed style) or a separate "window" (Thunderbird style).
    "open_in": "tab",
    // "markdown" or "plain".
    "format": "markdown",
    // Seconds during which a sent message can still be undone (0 to 30).
    "undo_send_seconds": 10,
    // Added below every message you send (Markdown), after your signature and above
    // the quoted message of a reply or forward. Empty: none. Shown under the body
    // while you write; it isn't part of the text you edit.
    "footer": "",
    // Adds "Sent with Maze (https://mazemail.dev)" below your messages. Thank you!
    "support_maze": true
  },

  // Spell-check languages as BCP 47 tags, e.g. ["de-AT", "en-US"]. Empty: the
  // system's languages.
  "spellcheck": [],

  // Which messages are kept on this computer: "headers_only", "recent" (bodies of the
  // last `offline_recent_days` days), "all" or "on_demand". Can be overridden per account.
  "offline": "recent",
  "offline_recent_days": 90,

  // Overrides per account, keyed by the account's label, e.g.
  // "work": { "offline": "all", "remote_content": "never", "footer": "Acme Inc." }
  // Supported keys: "offline", "offline_recent_days", "remote_content", "footer",
  // "support_maze".
  "accounts": {},

  // OAuth clients for "Sign in with Google" and "Sign in with Microsoft". Maze has no
  // Google client ID of its own yet: create an OAuth client of type "Desktop app" in
  // the Google Cloud console and enter its ID and secret here.
  "auth": {
    "google": {
      "client_id": null,
      "client_secret": null
    },
    "microsoft": {
      "client_id": null,
      // Which Microsoft Entra directory "Sign in with Microsoft" uses: "common" (work,
      // school and personal accounts), "organizations" (work and school accounts only),
      // "consumers" (personal accounts only), your tenant ID (a GUID) or a verified
      // domain of your organization ("contoso.com"). An app registration for "this
      // organization only" (single-tenant) needs the tenant ID or domain. Accounts keep
      // the tenant they signed in with; this applies to new sign-ins.
      "tenant": "common"
    }
  },

  // AI agents (docs/agents.md). AI is off unless enabled per account.
  "agent": {
    // The agent used when none is chosen explicitly: a registry id ("claude-acp",
    // "codex-acp", "gemini", "cursor", "pi-acp"), a short name ("claude", "codex",
    // "pi") or a key of "custom".
    "default": "claude",
    // Access per account label: "off", "local_only" (local models only) or "any".
    // Accounts not listed are "off". Agents Maze starts only ever see "any" accounts.
    "accounts": {},
    // What the session token of an agent started by Maze may do: "read-only",
    // "triage" (changes become proposals you review) or "writer".
    "session_profile": "triage",
    // Your own ACP agents, e.g.
    // "my-agent": { "name": "My agent", "command": "/usr/local/bin/my-agent",
    //               "args": ["--acp"], "env": { "MY_AGENT_MODEL": "small" } }
    // They run in the agent sandbox like registry agents.
    "custom": {},
    // Agents start with an empty environment. Extra variables per agent id, e.g.
    // "claude-acp": { "ANTHROPIC_MODEL": "…" }. This file is plain text: don't put API
    // keys here. Paste keys into the agent column's sign-in card instead; Maze keeps
    // them encrypted in its database and passes them only to that agent.
    "env": {},
    // Install new versions of installed agents in the background (checked at start
    // and every few hours). Running conversations keep their version. false: only
    // the "Update" button in the agent column.
    "auto_update": true
  },

  // The sandbox every agent process runs in.
  "agent_sandbox": {
    // Turning this off lets agents read your whole home directory.
    "enabled": true,
    // Extra paths in your home directory agents may read, e.g. "~/Documents/contracts".
    "allow_read": [],
    // Extra paths outside your home directory agents may never read.
    "deny_read": [],
    // Additions per agent, e.g. "claude-acp": { "read": [], "write": [] }.
    // "already_sandboxed": true runs that agent's own process outside Maze's sandbox
    // (for agents that sandbox themselves); its terminal commands stay sandboxed.
    "agent_paths": {},
    // null: any host. Or a list such as ["api.anthropic.com", "*.openai.com"].
    "network_hosts": null
  },

  // Look for updates in the background. false: only when asked
  // (command palette "Maze: Check for Updates").
  "auto_update": true,
  // "stable" or "preview". null: the channel of the installed build.
  "update_channel": null,
  // "background" (download and install, then offer a restart) or "notify_only".
  "auto_update_install": "background",

  // Notifications for new mail.
  "notifications": {
    "enabled": true,
    // What a notification shows: "sender_and_subject", "sender_only" or "none".
    // macOS keeps the text of delivered notifications in its own database.
    "content": "sender_and_subject",
    // The unread count on the dock icon.
    "dock_badge": true
  },

  // Log verbosity: "error", "warn", "info", "debug" or "trace". The MAZEMAIL_LOG
  // environment variable takes precedence.
  "log_level": "info",
}
