// Maze default keymap for macOS (Zed keymap format).
//
// Thunderbird's bindings are the default and win every conflict; Zed's fill the gaps
// (CONCEPT §12). Only actions that exist are bound; the rest of §12.2/§12.3 follows
// as the features land. Your own keymap.json is loaded after this file and wins.
[
  {
    "bindings": {
      "cmd-q": "maze::Quit",
      "cmd-h": "maze::Hide",
      "cmd-alt-h": "maze::HideOthers",
      "cmd-m": "maze::Minimize",
      // Thunderbird's "New Message"; works in every window (the compose window too).
      "cmd-n": "mail::NewMessage",
      // The macOS convention for Settings…; opens settings.json in a tab.
      "cmd-,": "maze::OpenSettings"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-p": "command_palette::Toggle",
      "cmd-b": "workspace::ToggleFolderPane",
      "cmd-?": "workspace::ToggleAgentColumn",
      "f8": "workspace::ToggleMessagePane",
      "cmd-k": "search::FocusSearch",
      "cmd-shift-k": "search::QuickFilter",
      // Not Thunderbird defaults (it has no keys for these); cmd-alt avoids its
      // single-key and cmd-shift bindings.
      "cmd-alt-t": "view::ToggleTableView",
      "cmd-alt-g": "view::ToggleThreads",
      "cmd-r": "mail::Reply",
      "cmd-shift-r": "mail::ReplyAll",
      "cmd-l": "mail::Forward",
      // Tabs and splits (Zed's keys, ADR-018). Zed's `cmd-k <arrow>` chords would make
      // Thunderbird's `cmd-k` (search) wait a second for a second key, so splitting in
      // a direction is `cmd-ctrl-<arrow>` and moving between panes `cmd-alt-<arrow>`.
      "cmd-w": "pane::CloseActiveItem",
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "cmd-}": "pane::ActivateNextItem",
      "cmd-{": "pane::ActivatePreviousItem",
      "cmd-1": ["pane::ActivateItem", 0],
      "cmd-2": ["pane::ActivateItem", 1],
      "cmd-3": ["pane::ActivateItem", 2],
      "cmd-4": ["pane::ActivateItem", 3],
      "cmd-5": ["pane::ActivateItem", 4],
      "cmd-6": ["pane::ActivateItem", 5],
      "cmd-7": ["pane::ActivateItem", 6],
      "cmd-8": ["pane::ActivateItem", 7],
      "cmd-9": "pane::ActivateLastItem",
      "cmd-\\": "pane::SplitRight",
      "cmd-ctrl-left": "pane::SplitLeft",
      "cmd-ctrl-right": "pane::SplitRight",
      "cmd-ctrl-up": "pane::SplitUp",
      "cmd-ctrl-down": "pane::SplitDown",
      "cmd-alt-left": "workspace::ActivatePaneLeft",
      "cmd-alt-right": "workspace::ActivatePaneRight",
      "cmd-alt-up": "workspace::ActivatePaneUp",
      "cmd-alt-down": "workspace::ActivatePaneDown"
    }
  },
  {
    // Single-key Thunderbird shortcuts work wherever a message or the list has focus,
    // never inside a text field.
    "context": "ThreadList || MessageView",
    "bindings": {
      "f": "mail::NextMessage",
      "b": "mail::PreviousMessage",
      "n": "mail::NextUnread",
      "p": "mail::PreviousUnread",
      "m": "mail::ToggleRead",
      "s": "mail::ToggleStar",
      "a": "mail::Archive",
      "shift-m": "mail::MoveToFolder",
      "cmd-z": "mail::Undo",
      "cmd-shift-a": "mail::SelectThread",
      // The message in a tab of its own (a double-click on the row does the same).
      "cmd-o": "mail::OpenMessage"
    }
  },
  {
    "context": "ThreadList",
    "bindings": {
      "down": "mail::NextMessage",
      "up": "mail::PreviousMessage",
      "shift-down": "mail::ExtendSelectionDown",
      "shift-up": "mail::ExtendSelectionUp",
      "cmd-a": "mail::SelectAll",
      "enter": "mail::OpenMessage",
      "home": "mail::FirstMessage",
      "end": "mail::LastMessage",
      "pagedown": "mail::PageDown",
      "pageup": "mail::PageUp",
      "right": "mail::ExpandThread",
      "left": "mail::CollapseThread",
      "*": "mail::ExpandAllThreads",
      "shift-8": "mail::ExpandAllThreads",
      "\\": "mail::CollapseAllThreads"
    }
  },
  {
    // The compose window (Thunderbird: cmd-enter sends, Escape closes).
    "context": "Composer",
    "bindings": {
      "cmd-enter": "composer::Send",
      "escape": "composer::Close",
      "cmd-s": "composer::SaveDraft",
      "cmd-shift-a": "composer::Attach",
      "cmd-shift-c": "composer::ToggleCcBcc"
    }
  },
  {
    // The settings tab (settings.json).
    "context": "SettingsEditor",
    "bindings": {
      "cmd-s": "settings_editor::SaveSettings"
    }
  },
  {
    // The table's own left/right move between columns; in the message list they open
    // and close threads, as in Thunderbird.
    "context": "ThreadList > DataTable",
    "bindings": {
      "right": "mail::ExpandThread",
      "left": "mail::CollapseThread"
    }
  },
  {
    // The agent column (Zed's agent panel keys). In its prompt, enter sends and
    // shift-enter starts a new line.
    "context": "AgentPanel",
    "bindings": {
      "cmd-n": "agent::NewThread",
      "cmd-shift-enter": "agent::AcceptAllProposals",
      "cmd-shift-backspace": "agent::RejectAllProposals"
    }
  },
  {
    // In the agent's prompt, Zed's keys for what the agent offers.
    "context": "AgentPrompt > Input",
    "bindings": {
      "shift-tab": "agent::CycleMode",
      "alt-tab": "agent::CycleModel",
      "ctrl-'": "agent::CycleThinking"
    }
  },
  {
    // The proposal review, once it has focus (click an item).
    "context": "AgentProposals",
    "bindings": {
      "y": "agent::AcceptProposal",
      "n": "agent::RejectProposal",
      "down": "agent::NextProposal",
      "up": "agent::PreviousProposal"
    }
  }
]
